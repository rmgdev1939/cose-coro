{
  "rules": {
    "estado": {
      ".read": "auth != null && auth.token.email_verified == true",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['on', 't']) && newData.child('on').isBoolean() && newData.child('t').isNumber()",
        "on": { ".validate": true },
        "t": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
