rules_version = '2';
// Reglas de seguridad para Cose Coro (Firestore).
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
// El primer administrador se marca a mano en la consola: después de crear su
// cuenta y confirmar el correo, en users/{su uid} poner status = "verificado"
// y role = "admin". Nadie puede darse ese rol solo.
// Para entrar a los datos hace falta: correo confirmado + cuenta aprobada.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function emailOk() { return signedIn() && request.auth.token.email_verified == true; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasMe() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // El área "Sistema PF" (temporal, COSEPF) no entra a ningún dato de Cose
    // Coro: solo lee su propia cuenta y la lista de áreas.
    function verified() { return emailOk() && hasMe() && me().status == "verificado"
      && (me().role == "admin" || me().get("cargo", "") != "Sistema PF"); }
    function admin() { return verified() && me().role == "admin"; }
    // Sucursales: cada quien ve solo la suya (Coro si no tiene). Las dos las
    // ven el administrador y quien él marque con "ambas". Los datos de Punto
    // Fijo van en colecciones con "PF" al final (codigosPF, faltantesPF…).
    function suc() { return me().get("sucursal", "Coro"); }
    function ambas() { return me().role == "admin" || me().get("ambas", false) == true; }
    function enSuc(s) { return verified() && (ambas() || suc() == s); }
    function sucDe(col) { return col.matches(".*PF") ? "Punto Fijo" : "Coro"; }
    function validProfile(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && (!("cargo" in d) || (d.cargo is string && d.cargo.size() <= 40))
        && (!("phone" in d) || (d.phone is string && d.phone.size() <= 20));
    }
    function tokenVerified() { return request.auth.token.email_verified == true; }
    // Editar el mapa: cargos Autoservicio e Inventario, y los administradores.
    // (Si cambia, cambiar también EDIT_CARGOS en la app.)
    function mapEditor() { return verified() && (me().role == "admin" || me().get("cargo", "") in ["Autoservicio", "Inventario"]); }
    // Chat: dos personas son compañeros si su conexión está aceptada.
    // La conexión de a y b se guarda en conexiones/{uid menor}_{uid mayor}.
    function pid(a, b) { return a < b ? a + "_" + b : b + "_" + a; }
    // Supervisión: SOLO la cuenta de Rafael Angel Morin Gutierrez puede leer
    // todos los chats (sin escribir en ellos). Hacer admin a otra persona no
    // le da este permiso: para cambiarlo hay que cambiar esta regla.
    function supervisor() { return verified() && request.auth.uid == "eabbcqq01NSHmbCiXMMToQIMzU72"; }
    function isCompa(a, b) {
      return get(/databases/$(database)/documents/conexiones/$(pid(a, b))).data.status == "aceptada";
    }

    // Cuentas de trabajadores
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      // Alta propia: siempre entra como pendiente y empleado, con su propio correo.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "email", "cargo", "emailVerified", "status", "role", "createdAt"])
        && request.resource.data.status == "pendiente"
        && request.resource.data.role == "empleado"
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == tokenVerified()
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // Perfil propio: nombre, teléfono, y marcar el correo como confirmado
      // (solo si el token de Firebase lo dice). El cargo solo lo cambia un
      // administrador, porque da permisos (editar el mapa).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(admin()
             ? ["name", "cargo", "phone", "emailVerified", "updatedAt"]
             : ["name", "phone", "emailVerified", "updatedAt"])
        && validProfile(request.resource.data)
        && (!("emailVerified" in request.resource.data) || request.resource.data.emailVerified == tokenVerified())
        && request.resource.data.updatedAt == request.time;
      // Administrador: aprueba o quita acceso y cambia el cargo de otros
      // (nunca a sí mismo). Solo aprueba a quien ya confirmó su correo.
      // Hay un solo administrador (Rafael): desde la app nadie puede dar ni
      // quitar el rol de admin (el campo role no se puede cambiar).
      allow update: if admin() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "verifiedAt", "verifiedBy", "cargo", "sucursal", "ambas", "rol"])
        && (!("rol" in request.resource.data) || (request.resource.data.rol is string && request.resource.data.rol.size() <= 40))
        && (!("cargo" in request.resource.data) || (request.resource.data.cargo is string && request.resource.data.cargo.size() <= 40))
        && (!("sucursal" in request.resource.data) || request.resource.data.sucursal in ["Coro", "Punto Fijo"])
        && (!("ambas" in request.resource.data) || request.resource.data.ambas is bool)
        && request.resource.data.status in ["verificado", "bloqueado"]
        && (request.resource.data.status != "verificado" || resource.data.emailVerified == true);
      allow delete: if false;
    }

    // Lista de cargos: la ve cualquiera (hace falta para crear la cuenta) y
    // solo el administrador la cambia.
    match /config/cargos {
      allow get: if true;
      allow write: if admin()
        && request.resource.data.keys().hasOnly(["list", "updatedBy", "updatedAt"])
        && request.resource.data.list is list
        && request.resource.data.list.size() >= 1 && request.resource.data.list.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Mapa de la tienda: una zona por documento
    // (por ahora solo existe el de Coro; el de Punto Fijo viene después)
    match /mapa/{zone} {
      allow read: if enSuc("Coro");
      allow write: if mapEditor() && enSuc("Coro")
        && request.resource.data.keys().hasOnly(["items", "updatedAt", "updatedBy", "updatedByName"])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 300
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Registro de cambios del mapa: se agrega, nunca se edita ni se borra
    match /mapaLog/{id} {
      allow read: if admin();
      allow create: if mapEditor() && enSuc("Coro")
        && request.resource.data.keys().hasOnly(["zone", "action", "item", "by", "byName", "at"])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------------- Chat ----------------------------------------------------
    // Perfil público (nombre, cargo, ícono) que ven los compañeros aprobados.
    match /perfiles/{uid} {
      allow read: if verified();
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "cargo", "icon", "foto", "medallas", "companeros", "c5", "updatedAt"])
        && (!("c5" in request.resource.data) || (request.resource.data.c5 is int
             && request.resource.data.c5 >= 0 && request.resource.data.c5 <= 100000))
        && (!("companeros" in request.resource.data) || (request.resource.data.companeros is int
             && request.resource.data.companeros >= 0 && request.resource.data.companeros <= 1000))
        && (!("foto" in request.resource.data) || (request.resource.data.foto is string
             && request.resource.data.foto.size() <= 40000
             && (request.resource.data.foto == "" || request.resource.data.foto.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+"))))
        && (!("medallas" in request.resource.data) || (request.resource.data.medallas is int
             && request.resource.data.medallas >= 0 && request.resource.data.medallas <= 100))
        && request.resource.data.name == me().name
        && request.resource.data.cargo == me().get("cargo", "")
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }

    // Solicitudes de compañero: una por pareja. La envía uno, la acepta el otro;
    // cualquiera de los dos la puede cancelar, rechazar o quitar (borrar).
    match /conexiones/{cid} {
      allow read: if verified() && request.auth.uid in resource.data.members;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(["members", "from", "to", "fromName", "toName", "status", "createdAt"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && cid == pid(request.auth.uid, request.resource.data.to)
        && request.resource.data.members == (request.auth.uid < request.resource.data.to
             ? [request.auth.uid, request.resource.data.to] : [request.resource.data.to, request.auth.uid])
        && request.resource.data.status == "pendiente"
        && request.resource.data.fromName == me().name
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 60
        && exists(/databases/$(database)/documents/perfiles/$(request.resource.data.to))
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && request.auth.uid == resource.data.to
        && resource.data.status == "pendiente"
        && request.resource.data.status == "aceptada"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedAt"])
        && request.resource.data.acceptedAt == request.time;
      allow delete: if verified() && request.auth.uid in resource.data.members;
    }

    // Conversaciones: "directo" (dos compañeros, id = conexión) o "grupo".
    match /chats/{chatId} {
      function newMembers() { return request.resource.data.members; }
      function okMember(i) { return newMembers().size() <= i || isCompa(request.auth.uid, newMembers()[i]); }

      allow read: if verified() && (request.auth.uid in resource.data.members || supervisor());

      allow create: if verified()
        && request.resource.data.type == "directo"
        && request.resource.data.keys().hasOnly(["type", "members", "createdBy", "createdAt"])
        && newMembers().size() == 2
        && request.auth.uid in newMembers()
        && newMembers()[0] < newMembers()[1]
        && chatId == newMembers()[0] + "_" + newMembers()[1]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isCompa(newMembers()[0], newMembers()[1]);

      // Grupo nuevo: quien lo crea va primero y solo mete a sus compañeros
      // (hasta 8 al crearlo; luego se agregan de uno en uno).
      allow create: if verified()
        && request.resource.data.type == "grupo"
        && request.resource.data.keys().hasOnly(["type", "members", "name", "createdBy", "createdAt"])
        && request.resource.data.createdBy == request.auth.uid
        && newMembers()[0] == request.auth.uid
        && newMembers().size() >= 2 && newMembers().size() <= 9
        && newMembers().toSet().size() == newMembers().size()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time
        && okMember(1) && okMember(2) && okMember(3) && okMember(4)
        && okMember(5) && okMember(6) && okMember(7) && okMember(8);

      // Último mensaje (para la lista de chats): lo escribe quien envía.
      allow update: if verified() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastText", "lastAt", "lastFrom", "lastFromName"])
        && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.lastFromName == me().name
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 120
        && request.resource.data.lastAt == request.time;

      // Palomitas: cada miembro marca solo lo suyo — hasta cuándo recibió
      // (recibido) y leyó (leido) los mensajes del chat.
      allow update: if verified() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["recibido", "leido"])
        && request.resource.data.get("recibido", {}).diff(resource.data.get("recibido", {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get("leido", {}).diff(resource.data.get("leido", {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get("recibido", {})) || request.resource.data.recibido[request.auth.uid] is timestamp)
        && (!(request.auth.uid in request.resource.data.get("leido", {})) || request.resource.data.leido[request.auth.uid] is timestamp);

      // Grupo: cualquier miembro agrega a un compañero suyo (uno a la vez, al final).
      allow update: if verified() && resource.data.type == "grupo"
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
        && newMembers().size() == resource.data.members.size() + 1
        && newMembers().size() <= 50
        && !(newMembers()[newMembers().size() - 1] in resource.data.members)
        && newMembers() == resource.data.members.concat([newMembers()[newMembers().size() - 1]])
        && isCompa(request.auth.uid, newMembers()[newMembers().size() - 1]);

      // Grupo: salirse (cada quien se quita a sí mismo).
      allow update: if signedIn() && resource.data.type == "grupo"
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
        && newMembers().size() == resource.data.members.size() - 1
        && newMembers().toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet());

      allow delete: if false;

      // Mensajes: solo miembros; en un chat directo, solo si siguen siendo compañeros.
      match /mensajes/{mid} {
        function chatNow() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function chatAfter() { return getAfter(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if verified() && (request.auth.uid in chatNow().members || supervisor());
        allow create: if verified()
          && request.resource.data.keys().hasOnly(["from", "fromName", "text", "at"])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.fromName == me().name
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.at == request.time
          && request.auth.uid in chatAfter().members
          && (chatAfter().type == "grupo" || isCompa(chatAfter().members[0], chatAfter().members[1]));
        allow update, delete: if false;
      }
    }

    // Hasta dónde leyó cada quien cada chat (para marcar los no leídos).
    match /lecturas/{uid} {
      allow read: if verified() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["c", "av"])
        && (!("c" in request.resource.data) || request.resource.data.c is map)
        && (!("av" in request.resource.data) || request.resource.data.av is timestamp);
      allow delete: if false;
    }

    // Vehículos (flota): los ven Mecánicos, Gerencia y el administrador; los
    // agregan y editan Mecánicos y el administrador; borrar, solo el administrador.
    function flotaVer() { return verified() && (me().role == "admin" || me().get("cargo", "") in ["Mecánicos", "Gerencia", "Choferes"]); }
    function comprasVer() { return verified() && (me().role == "admin" || me().get("cargo", "") in ["Compras", "Gerencia"]); }
    function flotaEditar() { return verified() && (me().role == "admin" || me().get("cargo", "") == "Mecánicos"); }
    function vehiculoOk(d) {
      return d.keys().hasOnly(["placa", "tipo", "marca", "modelo", "anio", "color", "km", "estado", "notas", "creadoPor", "creadoPorNombre", "createdAt", "updatedAt", "updatedBy", "updatedByName"])
        && d.placa is string && d.placa.size() >= 2 && d.placa.size() <= 12
        && d.tipo in ["camion", "camioneta", "carro", "moto", "montacargas", "otro"]
        && d.marca is string && d.marca.size() <= 30
        && d.modelo is string && d.modelo.size() <= 30
        && (!("anio" in d) || (d.anio is int && d.anio >= 1950 && d.anio <= 2100))
        && d.color is string && d.color.size() <= 20
        && d.km is int && d.km >= 0 && d.km <= 3000000
        && d.estado in ["operativo", "taller", "fuera"]
        && d.notas is string && d.notas.size() <= 500
        && d.updatedBy == request.auth.uid && d.updatedByName == me().name && d.updatedAt == request.time;
    }
    match /{col}/{id} {
      allow read: if col in ["vehiculos", "vehiculosPF"] && flotaVer() && enSuc(sucDe(col));
      allow create: if col in ["vehiculos", "vehiculosPF"] && enSuc(sucDe(col)) && flotaEditar() && vehiculoOk(request.resource.data)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorNombre == me().name
        && request.resource.data.createdAt == request.time;
      allow update: if col in ["vehiculos", "vehiculosPF"] && enSuc(sucDe(col)) && flotaEditar() && vehiculoOk(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["placa", "tipo", "marca", "modelo", "anio", "color", "km", "estado", "notas", "updatedAt", "updatedBy", "updatedByName"]);
      allow delete: if col in ["vehiculos", "vehiculosPF"] && admin();
    }

    // Mantenimientos de cada vehículo (los registran Mecánicos y el administrador).
    function vehCol(col) { return sucDe(col) == "Coro" ? "vehiculos" : "vehiculosPF"; }
    match /{col}/{id} {
      allow read: if col in ["mantenimientos", "mantenimientosPF"] && flotaVer() && enSuc(sucDe(col));
      allow create: if col in ["mantenimientos", "mantenimientosPF"] && enSuc(sucDe(col)) && flotaEditar()
        && request.resource.data.keys().hasOnly(["vehiculoId", "placa", "fecha", "tipo", "km", "detalle", "by", "byName", "at"])
        && request.resource.data.vehiculoId is string && exists(/databases/$(database)/documents/$(vehCol(col))/$(request.resource.data.vehiculoId))
        && request.resource.data.placa is string && request.resource.data.placa.size() <= 12
        && request.resource.data.fecha is string && request.resource.data.fecha.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
        && request.resource.data.tipo in ["aceite", "cauchos", "frenos", "bateria", "electrico", "motor", "otro"]
        && request.resource.data.km is int && request.resource.data.km >= 0 && request.resource.data.km <= 3000000
        && request.resource.data.detalle is string && request.resource.data.detalle.size() <= 500
        && request.resource.data.by == request.auth.uid && request.resource.data.byName == me().name
        && request.resource.data.at == request.time;
      allow delete: if col in ["mantenimientos", "mantenimientosPF"] && admin();
    }

    // Revisión diaria del vehículo: la hacen Choferes y Mecánicos (y el administrador).
    match /{col}/{id} {
      allow read: if col in ["revisiones", "revisionesPF"] && flotaVer() && enSuc(sucDe(col));
      allow create: if col in ["revisiones", "revisionesPF"] && enSuc(sucDe(col)) && (me().role == "admin" || me().get("cargo", "") in ["Choferes", "Mecánicos"])
        && request.resource.data.keys().hasOnly(["vehiculoId", "placa", "puntos", "fallas", "km", "combustible", "nota", "by", "byName", "at"])
        && request.resource.data.vehiculoId is string && exists(/databases/$(database)/documents/$(vehCol(col))/$(request.resource.data.vehiculoId))
        && request.resource.data.placa is string && request.resource.data.placa.size() <= 12
        && request.resource.data.puntos is map
        && request.resource.data.fallas is int && request.resource.data.fallas >= 0 && request.resource.data.fallas <= 20
        && request.resource.data.km is int && request.resource.data.km >= 0 && request.resource.data.km <= 3000000
        && request.resource.data.combustible in ["vacio", "1/4", "1/2", "3/4", "lleno"]
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 300
        && request.resource.data.by == request.auth.uid && request.resource.data.byName == me().name
        && request.resource.data.at == request.time;
      allow delete: if col in ["revisiones", "revisionesPF"] && admin();
    }

    // "Lo pidieron y no hay": cualquiera lo anota; lo ven y lo marcan Compras,
    // Gerencia y el administrador.
    match /{col}/{id} {
      allow read: if col in ["faltantes", "faltantesPF"] && enSuc(sucDe(col))
        && (comprasVer() || resource.data.by == request.auth.uid);
      allow create: if col in ["faltantes", "faltantesPF"] && enSuc(sucDe(col))
        && request.resource.data.keys().hasOnly(["producto", "nota", "by", "byName", "at", "estado"])
        && request.resource.data.producto is string && request.resource.data.producto.size() >= 2 && request.resource.data.producto.size() <= 80
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 200
        && request.resource.data.by == request.auth.uid && request.resource.data.byName == me().name
        && request.resource.data.estado == "pendiente"
        && request.resource.data.at == request.time;
      allow update: if col in ["faltantes", "faltantesPF"] && enSuc(sucDe(col)) && comprasVer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado"])
        && request.resource.data.estado in ["pendiente", "pedido", "descartado"];
      allow delete: if col in ["faltantes", "faltantesPF"] && admin();
    }

    // Códigos de radio del 1 al 8 (el 5: bajar mercancía a chequeo).
    // Lo pide Autoservicio; Autoservicio y el administrador lo aceptan o
    // rechazan; quien lo aceptó lo marca llevado; quien lo pidió lo cancela.
    function autoserv() { return verified() && (me().role == "admin" || me().get("cargo", "") == "Autoservicio"); }
    match /{col}/{id} {
      allow read: if col in ["codigos", "codigosPF"] && enSuc(sucDe(col));
      allow create: if col in ["codigos", "codigosPF"] && enSuc(sucDe(col)) && autoserv()
        && request.resource.data.keys().hasOnly(["codigo", "pedido", "destino", "nota", "by", "byName", "at", "estado"])
        && (!("destino" in request.resource.data) || (request.resource.data.destino is string && request.resource.data.destino.size() <= 30))
        && request.resource.data.codigo is int && request.resource.data.codigo >= 1 && request.resource.data.codigo <= 8
        && request.resource.data.pedido is string && request.resource.data.pedido.size() >= 2 && request.resource.data.pedido.size() <= 80
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 200
        && request.resource.data.by == request.auth.uid && request.resource.data.byName == me().name
        && request.resource.data.estado == "abierto"
        && request.resource.data.at == request.time;
      // aceptar
      allow update: if col in ["codigos", "codigosPF"] && enSuc(sucDe(col)) && autoserv() && resource.data.estado == "abierto"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "tomadoPor", "tomadoPorNombre", "tomadoAt"])
        && request.resource.data.estado == "aceptado"
        && request.resource.data.tomadoPor == request.auth.uid
        && request.resource.data.tomadoPorNombre == me().name
        && request.resource.data.tomadoAt == request.time;
      // rechazar (solo se quita el globo de quien rechaza)
      allow update: if col in ["codigos", "codigosPF"] && enSuc(sucDe(col)) && autoserv() && resource.data.estado == "abierto"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rechazos"])
        && !(request.auth.uid in resource.data.get("rechazos", []))
        && request.resource.data.rechazos == resource.data.get("rechazos", []).concat([request.auth.uid])
        && request.resource.data.rechazos.size() <= 100;
      // lo llevó a chequeo
      allow update: if col in ["codigos", "codigosPF"] && enSuc(sucDe(col)) && resource.data.estado == "aceptado"
        && resource.data.tomadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "finAt"])
        && request.resource.data.estado == "llevado"
        && request.resource.data.finAt == request.time;
      // cancelar
      allow update: if col in ["codigos", "codigosPF"] && enSuc(sucDe(col)) && (resource.data.by == request.auth.uid || admin())
        && resource.data.estado in ["abierto", "aceptado"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "finAt"])
        && request.resource.data.estado == "cancelado"
        && request.resource.data.finAt == request.time;
      allow delete: if col in ["codigos", "codigosPF"] && admin();
    }

    // Capacitación: las lecciones aprobadas de cada quien (el total de
    // medallas se muestra en perfiles/{uid}.medallas).
    match /capacitaciones/{uid} {
      allow read: if verified() && (request.auth.uid == uid || admin());
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["hechas"])
        && request.resource.data.hechas is map;
      allow delete: if false;
    }

    // Avisos del administrador para todos: del sistema o de actualizaciones.
    match /avisos/{id} {
      allow read: if verified();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(["titulo", "texto", "tipo", "by", "byName", "at"])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 80
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 1000
        && request.resource.data.tipo in ["sistema", "actualizacion"]
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName == me().name
        && request.resource.data.at == request.time;
      allow delete: if admin();
      allow update: if false;
    }

    // Soporte: cada quien reporta fallos, sugerencias o preguntas y ve los
    // suyos; el administrador los ve todos, cambia el estado y responde.
    match /reportes/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow create: if verified()
        && request.resource.data.keys().hasOnly(["uid", "nombre", "tipo", "texto", "version", "pantalla", "equipo", "estado", "at"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nombre == me().name
        && request.resource.data.tipo in ["fallo", "sugerencia", "pregunta"]
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 5 && request.resource.data.texto.size() <= 2000
        && request.resource.data.version is string && request.resource.data.version.size() <= 60
        && request.resource.data.pantalla is string && request.resource.data.pantalla.size() <= 40
        && request.resource.data.equipo is string && request.resource.data.equipo.size() <= 300
        && request.resource.data.estado == "nuevo"
        && request.resource.data.at == request.time;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "respuesta", "respondidoAt"])
        && request.resource.data.estado in ["nuevo", "revisando", "resuelto"]
        && (!("respuesta" in request.resource.data) || (request.resource.data.respuesta is string && request.resource.data.respuesta.size() <= 1000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["respuesta"]) || request.resource.data.respondidoAt == request.time);
      allow delete: if false;
    }

    // Estado del sistema (consumo del plan gratis): lo escribe el medidor de
    // tools/monitor.cjs con la cuenta del dueño; lo lee solo el administrador.
    // Uso de la app: cada persona escribe solo el suyo (visto por última vez,
    // entradas, minutos por día, aparato…). Lo lee el administrador; la
    // persona lee el suyo solo para borrar días viejos. Nadie lo borra.
    match /uso/{uid} {
      allow read: if admin() || (verified() && request.auth.uid == uid);
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "ultimaVez", "aperturas", "ingresos", "ultimoIngreso", "aparato", "instalada", "version", "min"])
        && request.resource.data.ultimaVez == request.time
        && request.resource.data.get("name", "") is string && request.resource.data.get("name", "").size() <= 60
        && request.resource.data.get("aparato", "") is string && request.resource.data.get("aparato", "").size() <= 20
        && request.resource.data.get("version", "") is string && request.resource.data.get("version", "").size() <= 24
        && request.resource.data.get("instalada", false) is bool
        && request.resource.data.get("aperturas", 0) is int
        && request.resource.data.get("ingresos", 0) is int
        && request.resource.data.get("min", {}) is map && request.resource.data.get("min", {}).size() <= 120
        && (!("ultimoIngreso" in request.resource.data) || request.resource.data.ultimoIngreso is timestamp);
      allow delete: if false;
    }

    // ---------------- Profit (existencia y precio, solo lectura) --------------
    // Los escribe SOLO la cuenta del puente (tools en el iMac de la tienda, que
    // lee Profit con un usuario de solo lectura). Nadie más escribe aquí.
    function puente() { return request.auth != null && request.auth.uid == "pYoTcWzxM7PiBPiMDwl2KHpre5M2"; }
    function puenteDoc(d) {
      return (d.keys().hasOnly(["datos", "n", "hash", "actualizado"]) && d.datos is string && d.n is int && d.hash is string && d.actualizado is timestamp)
        || (d.keys().hasOnly(["grupos", "total", "actualizado", "almacenes", "precio"]) && d.grupos is map && d.total is int && d.actualizado is timestamp);
    }
    // Con existencia y precio 05 (público): todos los trabajadores aprobados
    // (Profit de Coro: solo lo ve quien ve Coro)
    match /profit/{doc} {
      allow read: if enSuc("Coro");
      allow write: if puente() && puenteDoc(request.resource.data);
    }
    // Agotados ("los vendíamos y no hay"): Compras, Gerencia y administración
    match /profitAgotados/{doc} {
      allow read: if comprasVer() && enSuc("Coro");
      allow write: if puente() && puenteDoc(request.resource.data);
    }

    match /monitor/{doc} {
      allow read: if admin();
      allow write: if false;
    }

    // ---------------- Avisos con la app cerrada (notificaciones push) ---------
    // Llave pública para activar los avisos: la escribe solo el enviador del
    // iMac (tools/avisos/avisos-push.cjs, con la cuenta del dueño, que no pasa
    // por estas reglas). La leen las personas aprobadas; desde la app nadie
    // la cambia.
    match /config/push {
      allow get: if verified();
      allow list, write: if false;
    }

    // Equipos que reciben los avisos: un documento por persona y equipo, con
    // id = {uid}_{equipo}. Cada quien guarda solo los suyos, con la hora del
    // servidor. Nadie los lee desde la app (ni la persona ni el administrador):
    // solo el enviador del iMac. Cada quien borra los suyos siempre, aunque el
    // documento ya no exista o la cuenta ya no esté aprobada (al desactivar
    // los avisos o al cerrar sesión).
    match /push/{id} {
      // endpoint: dirección del servicio de avisos del teléfono (solo https,
      // sin espacios). p256dh y auth: llaves del equipo (base64url, sin "=").
      function pushOk(d) {
        return d.keys().hasAll(["uid", "dev", "endpoint", "p256dh", "auth", "ua", "at"])
          && d.keys().hasOnly(["uid", "dev", "endpoint", "p256dh", "auth", "ua", "at"])
          && d.uid == request.auth.uid
          && d.dev is string && d.dev.matches("[a-z0-9]{8,24}")
          && id == request.auth.uid + "_" + d.dev
          && d.endpoint is string && d.endpoint.size() <= 800
          && d.endpoint.matches("https://[A-Za-z0-9.-]+/[!-~]*")
          && d.p256dh is string && d.p256dh.matches("[A-Za-z0-9_-]{60,120}")
          && d.auth is string && d.auth.matches("[A-Za-z0-9_-]{16,40}")
          && d.ua is string && d.ua.size() <= 120
          && d.at == request.time;
      }
      allow read: if false;
      allow create, update: if verified() && pushOk(request.resource.data);
      allow delete: if signedIn() && id.split("_").size() == 2 && id.split("_")[0] == request.auth.uid;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
